{
  "manifest_version": 3,
  "name": "Signal Desk 抖音只读连接器",
  "version": "0.1.6",
  "key": "",
  "description": "将当前登录状态下公开可见的抖音关注、作品与评论发送到本机 Signal Desk。",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://v.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Signal Desk 连接器",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
