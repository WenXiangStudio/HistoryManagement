{
  "manifest_version": 3,
  "name": "Signal Desk 关注目录同步",
  "version": "0.2.0",
  "description": "从 APP 配置页启动，仅保存当前账号前 10 位关注博主的基础信息。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://www.douyin.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["setup-content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.douyin.com/user/self*"], "js": ["following-dom.js", "following-trigger.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Signal Desk 关注目录同步", "default_popup": "popup.html" },
  "minimum_chrome_version": "120"
}
