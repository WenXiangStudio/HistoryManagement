{
  "manifest_version": 3,
  "name": "Signal Desk Phase B 隔离评论 PoC",
  "version": "0.2.4",
  "description": "已由 R0 冻结并禁用的 0.2.4 历史路线；仅保留为失败证据，不可启动新 run。",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Signal Desk Phase B PoC",
    "default_popup": "popup.html"
  }
}
