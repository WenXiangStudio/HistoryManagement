{
  "manifest_version": 3,
  "name": "Signal Desk R8 批量路线隔离验证（自动运行）",
  "version": "0.8.2",
  "description": "仅验证 R8 只读结构化路线，报告写入隔离临时目录。",
  "permissions": ["tabs", "storage", "debugger"],
  "host_permissions": ["https://www.douyin.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://www.douyin.com/*"],
    "js": ["r8-trigger.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Signal Desk R8 T1", "default_popup": "popup.html" },
  "minimum_chrome_version": "120"
}
